# --- данные (ТЗ §3): наполняются скриптами, в репозиторий не попадают ---
data/*
!data/.gitkeep
# Публичные наборы для участников контеста. Эталон test.parquet остаётся закрытым.
!data/fragments/
data/fragments/*
!data/fragments/train.parquet
!data/fragments/val.parquet
!data/fragments/test_unlabeled.parquet

# --- окружение ---
.venv/
venv/
*.egg-info/
build/
dist/
__pycache__/
*.py[cod]

# --- инструменты ---
# .python-version коммитится: по нему uv выбирает интерпретатор (см. README).
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.logs/

# --- черновая работа: клоны чужих репозиториев для оценки (ТЗ §17.5) ---
.scratch/

# --- артефакты прогонов ---
results.json
noise_floor.json
# Графики приёмки §14 генерируются scripts/acceptance_plots.py и не коммитятся.
reports/
